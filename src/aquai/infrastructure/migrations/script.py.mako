"""${message}

Revisión: ${up_revision}
Revisión anterior: ${down_revision | comma,n}
Fecha de creación: ${create_date}
"""

from collections.abc import Sequence

from alembic import op
import sqlalchemy as sa
${imports if imports else ""}

# Identificadores que Alembic usa para ordenar las migraciones.
revision: str = ${repr(up_revision)}
down_revision: str | Sequence[str] | None = ${repr(down_revision)}
branch_labels: str | Sequence[str] | None = ${repr(branch_labels)}
depends_on: str | Sequence[str] | None = ${repr(depends_on)}


def upgrade() -> None:
    """Aplica los cambios de esta migración."""
    ${upgrades.replace("# ### commands auto generated by Alembic - please adjust! ###", "# Operaciones generadas por Alembic: revisalas antes de aplicar.").replace("# ### end Alembic commands ###", "# Fin de las operaciones generadas.") if upgrades else "pass"}


def downgrade() -> None:
    """Revierte los cambios de esta migración."""
    ${downgrades.replace("# ### commands auto generated by Alembic - please adjust! ###", "# Operaciones generadas por Alembic: revisalas antes de aplicar.").replace("# ### end Alembic commands ###", "# Fin de las operaciones generadas.") if downgrades else "pass"}
