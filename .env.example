# PostgreSQL: servicio de Docker Compose.
POSTGRES_DB=aquai
POSTGRES_USER=aquai_user
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=5432

# Conexión del backend ejecutado en el host.
# Debe coincidir con POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_PORT.
# Codificar los caracteres especiales de las credenciales; por ejemplo, @ como %40.
DATABASE_URL=postgresql+psycopg://aquai_user:your_password@localhost:5432/aquai

# Límites de ingesta tabular.
# Tamaños en bytes: archivo de 10 MiB y contenido descomprimido de 100 MiB.
TABULAR_MAX_UPLOAD_BYTES=10485760
TABULAR_MAX_CELLS=2000000
TABULAR_MAX_SHEETS=30
TABULAR_MAX_EXPANDED_BYTES=104857600
TABULAR_SAMPLE_ROWS=12
TABULAR_MAX_DATASETS=100
TABULAR_MAX_COLUMNS=1024

# Ollama: asistencia de estructura y descripción de datasets.
# Instalar este modelo y el de embeddings en Ollama. Tiempos en segundos.
TABULAR_OLLAMA_BASE_URL=http://localhost:11434
TABULAR_DEFAULT_MODEL=qwen3.5:9b
TABULAR_STRUCTURE_ASSISTANCE=true
TABULAR_LLM_TIMEOUT_SECONDS=600
TABULAR_LLM_NUM_CTX=32768
TABULAR_LLM_THINK=false

# Embeddings: modelo independiente del usado para estructura y descripción.
TABULAR_EMBEDDING_MODEL=nomic-embed-text
TABULAR_EMBEDDING_TIMEOUT_SECONDS=120

# Qdrant: puerto publicado por Docker y conexión desde el host.
# Si cambia QDRANT_PORT, actualizar también TABULAR_QDRANT_URL.
QDRANT_PORT=6333
TABULAR_QDRANT_URL=http://localhost:6333
TABULAR_QDRANT_COLLECTION=aquai_datasets
TABULAR_INDEX_TIMEOUT_SECONDS=60

# SQL Agent: conexión opcional con rol limitado a SELECT. Vacío reutiliza DATABASE_URL.
SQL_EXECUTION_DATABASE_URL=
SQL_EXECUTION_DATASET_SCHEMA=public
SQL_EXECUTION_STATEMENT_TIMEOUT_MS=10000
SQL_EXECUTION_LOCK_TIMEOUT_MS=2000
SQL_EXECUTION_MAX_DURATION_MS=30000
SQL_EXECUTION_MAX_ROWS=1000
SQL_EXECUTION_MAX_RESULT_BYTES=1048576
SQL_EXECUTION_MAX_ROW_BYTES=65536

# Python Agent: entradas completas, sin ampliar ni repetir las consultas SQL.
PYTHON_EXECUTION_MAX_INPUT_ROWS=1000
PYTHON_EXECUTION_MAX_INPUT_BYTES=1048576
PYTHON_EXECUTION_MAX_CELLS=20000
PYTHON_EXECUTION_MAX_MEMORY_BYTES=16777216
PYTHON_EXECUTION_MAX_DURATION_MS=10000
PYTHON_EXECUTION_MAX_RESULT_ROWS=1000
PYTHON_EXECUTION_MAX_RESULT_BYTES=1048576
PYTHON_EXECUTION_MAX_CHART_POINTS=1000
PYTHON_EXECUTION_MAX_CHART_SERIES=50
PYTHON_EXECUTION_DECIMAL_PRECISION=38

# Response Generator: sólo evidencia autorizada, sin JSON Plotly ni tablas completas.
RESPONSE_CONTEXT_MAX_BYTES=24000
RESPONSE_MAX_PREVIEW_ROWS=10
