POSTGRES_DB=aquai
POSTGRES_USER=aquai_user
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=5432

# Conexión de la aplicación desde el host. En Compose, usar postgres:5432.
# Codificar los caracteres especiales de las credenciales; por ejemplo, @ como %40.
DATABASE_URL=postgresql+psycopg://aquai_user:your_password@localhost:5432/aquai

TABULAR_OLLAMA_BASE_URL=http://localhost:11434
TABULAR_DEFAULT_MODEL=qwen3:14b
TABULAR_LLM_TIMEOUT_SECONDS=180
TABULAR_MAX_UPLOAD_BYTES=10485760
TABULAR_MAX_CELLS=2000000
TABULAR_MAX_SHEETS=30
TABULAR_MAX_EXPANDED_BYTES=104857600
TABULAR_SAMPLE_ROWS=12
