#
# PostgreSQL del contenedor de Docker Compose.
#
POSTGRES_DB=aquai
POSTGRES_USER=aquai_user
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=5432

#
# Conexión del backend a PostgreSQL; coincide con POSTGRES_* (@ se escribe %40).
#
DATABASE_URL=postgresql+psycopg://aquai_user:your_password@localhost:5432/aquai

#
# Límites de ingesta de planillas, tamaños en bytes; la asistencia de estructura usa el agente tabular.
#
TABULAR_MAX_UPLOAD_BYTES=10485760
TABULAR_MAX_CELLS=2000000
TABULAR_MAX_SHEETS=30
TABULAR_MAX_EXPANDED_BYTES=104857600
TABULAR_SAMPLE_ROWS=12
TABULAR_MAX_DATASETS=100
TABULAR_MAX_COLUMNS=1024
TABULAR_STRUCTURE_ASSISTANCE=true

#
# Documentos PDF y DOCX: límites de carga, conversión con Docling y OCR sólo en páginas sin
# capa de texto; CHUNK_TOKENIZER debe corresponder al modelo de embeddings de documentos.
# SYMBOL_MAX_READINGS y FIGURE_OCR_MAX acotan cuánto se contrasta con la página por documento.
#
DOCUMENT_MAX_UPLOAD_BYTES=67108864
DOCUMENT_MAX_PAGES=1000
DOCUMENT_MAX_EXPANDED_BYTES=536870912
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=3600
DOCUMENT_CONVERSION_THREADS=6
DOCUMENT_OCR_MAX_PAGE_CHARS=50
DOCUMENT_OCR_MIN_IMAGE_COVERAGE=0.1
DOCUMENT_SYMBOL_MAX_READINGS=300
DOCUMENT_FIGURE_OCR_MAX=60
DOCUMENT_CHUNK_TOKENIZER=BAAI/bge-m3
DOCUMENT_CHUNK_MAX_TOKENS=512
DOCUMENT_QDRANT_COLLECTION=aquai_documents
DOCUMENT_INDEX_TIMEOUT_SECONDS=60
DOCUMENT_INDEX_BATCH_SIZE=32
DOCUMENT_SEARCH_LIMIT=40
DOCUMENT_SEARCH_CANDIDATES=15
DOCUMENT_SEARCH_CANDIDATE_CHARS=700
DOCUMENT_SEARCH_FRAGMENTS=6
DOCUMENT_SEARCH_FRAGMENTS_PER_DOCUMENT=3

#
# Qdrant: puerto de Docker y URL desde el host; cambiarlos juntos.
#
QDRANT_PORT=6333
TABULAR_QDRANT_URL=http://127.0.0.1:6333
TABULAR_QDRANT_COLLECTION=aquai_datasets
TABULAR_INDEX_TIMEOUT_SECONDS=60

#
# Agentes LLM en Ollama. Por agente: MODEL; NUM_CTX, ventana de contexto en tokens;
# MAX_OUTPUT_TOKENS, tope de salida (se acota a NUM_CTX/4); CONTEXT_MAX_BYTES, tope de la
# evidencia enviada (2048 a 96000, también acotado por NUM_CTX); TEMPERATURE; THINK; TIMEOUT_SECONDS.
# Los agentes SQL, Python y de validación son deterministas y no usan LLM.
#

#
# Servidor de Ollama (usar 127.0.0.1) y tiempo que mantiene cargado cada modelo entre consultas.
#
LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_OLLAMA_KEEP_ALIVE=30m

#
# Agente tabular: sugiere la estructura de las planillas y describe datasets y columnas al cargarlos.
#
LLM_TABULAR_MODEL=qwen3.5:9b
LLM_TABULAR_NUM_CTX=32768
LLM_TABULAR_TEMPERATURE=0
LLM_TABULAR_THINK=false
LLM_TABULAR_TIMEOUT_SECONDS=600

#
# Embeddings: indexan y buscan datasets en Qdrant; distinto de los modelos de chat y, si cambia, reindexar.
#
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_EMBEDDING_TIMEOUT_SECONDS=120

#
# Embeddings de documentos: multilingües, para buscar en español sobre papers en inglés;
# si cambia el modelo, usar una colección nueva en DOCUMENT_QDRANT_COLLECTION.
#
LLM_DOCUMENT_EMBEDDING_MODEL=bge-m3
LLM_DOCUMENT_EMBEDDING_TIMEOUT_SECONDS=300

#
# Router: interpreta la consulta con el historial y elige la ruta (general, catálogo, datos o histórico).
#
LLM_ROUTER_MODEL=qwen3.5:9b
LLM_ROUTER_NUM_CTX=32768
LLM_ROUTER_MAX_OUTPUT_TOKENS=768
LLM_ROUTER_CONTEXT_MAX_BYTES=24000
LLM_ROUTER_TEMPERATURE=0
LLM_ROUTER_THINK=false
LLM_ROUTER_TIMEOUT_SECONDS=600

#
# Respuesta general: contesta saludos y consultas conceptuales que no requieren los datos cargados.
#
LLM_GENERAL_MODEL=qwen3.5:9b
LLM_GENERAL_NUM_CTX=32768
LLM_GENERAL_MAX_OUTPUT_TOKENS=1536
LLM_GENERAL_CONTEXT_MAX_BYTES=24000
LLM_GENERAL_TEMPERATURE=0
LLM_GENERAL_THINK=false
LLM_GENERAL_TIMEOUT_SECONDS=600

#
# Planner: arma el plan de la consulta (datasets, columnas, filtros y pasos SQL o Python).
#
LLM_PLANNER_MODEL=qwen3.5:9b
LLM_PLANNER_NUM_CTX=32768
LLM_PLANNER_MAX_OUTPUT_TOKENS=4096
LLM_PLANNER_CONTEXT_MAX_BYTES=96000
LLM_PLANNER_TEMPERATURE=0
LLM_PLANNER_THINK=false
LLM_PLANNER_TIMEOUT_SECONDS=600

#
# Redactor: escribe la respuesta final a partir de la evidencia verificada.
#
LLM_RESPONSE_MODEL=qwen3.5:9b
LLM_RESPONSE_NUM_CTX=32768
LLM_RESPONSE_MAX_OUTPUT_TOKENS=2048
LLM_RESPONSE_CONTEXT_MAX_BYTES=24000
LLM_RESPONSE_TEMPERATURE=0
LLM_RESPONSE_THINK=false
LLM_RESPONSE_TIMEOUT_SECONDS=600

#
# SQL Agent: conexión opcional de solo lectura (vacía usa DATABASE_URL) y límites.
#
SQL_EXECUTION_DATABASE_URL=
SQL_EXECUTION_DATASET_SCHEMA=public
SQL_EXECUTION_STATEMENT_TIMEOUT_MS=10000
SQL_EXECUTION_LOCK_TIMEOUT_MS=2000
SQL_EXECUTION_MAX_DURATION_MS=30000
SQL_EXECUTION_MAX_ROWS=1000
SQL_EXECUTION_MAX_RESULT_BYTES=1048576
SQL_EXECUTION_MAX_ROW_BYTES=65536

#
# Python Agent: límites de entrada, memoria, tiempo y resultados.
#
PYTHON_EXECUTION_MAX_INPUT_ROWS=1000
PYTHON_EXECUTION_MAX_INPUT_BYTES=1048576
PYTHON_EXECUTION_MAX_CELLS=20000
PYTHON_EXECUTION_MAX_MEMORY_BYTES=16777216
PYTHON_EXECUTION_MAX_DURATION_MS=10000
PYTHON_EXECUTION_MAX_RESULT_ROWS=1000
PYTHON_EXECUTION_MAX_RESULT_BYTES=1048576
PYTHON_EXECUTION_MAX_CHART_POINTS=1000
PYTHON_EXECUTION_MAX_CHART_SERIES=50
PYTHON_EXECUTION_DECIMAL_PRECISION=38

#
# Redactor: filas que se describen en el texto de la respuesta.
#
RESPONSE_MAX_PREVIEW_ROWS=3

#
# Conversaciones: timeout del grafo y límites de cada mensaje guardado. La reserva de una respuesta en
# curso dura GENERATION_LEASE_SECONDS (mínimo 30) y se renueva cada tercio mientras se ejecuta: si el
# backend se reinicia, la conversación se libera en ese plazo.
#
CONVERSATIONS_GENERATION_TIMEOUT_SECONDS=1500
CONVERSATIONS_GENERATION_LEASE_SECONDS=45
CONVERSATIONS_MAX_MESSAGE_BYTES=2097152
CONVERSATIONS_MAX_TABLE_ROWS=100
CONVERSATIONS_MAX_TABLE_BYTES=262144
CONVERSATIONS_MAX_SOURCE_DETAILS_BYTES=65536
CONVERSATIONS_HISTORY_MESSAGES=8
CONVERSATIONS_LOCK_TIMEOUT_MS=2000
CONVERSATIONS_STATEMENT_TIMEOUT_MS=10000

#
# Evidencia documental: reescribe búsquedas, ordena fragmentos y propone valores de referencia.
# Usa el mismo modelo y contexto que los demás agentes para que Ollama no lo recargue.
#
LLM_EVIDENCE_MODEL=qwen3.5:9b
LLM_EVIDENCE_NUM_CTX=32768
LLM_EVIDENCE_MAX_OUTPUT_TOKENS=1024
LLM_EVIDENCE_CONTEXT_MAX_BYTES=24000
LLM_EVIDENCE_TEMPERATURE=0
LLM_EVIDENCE_THINK=false
LLM_EVIDENCE_TIMEOUT_SECONDS=600
